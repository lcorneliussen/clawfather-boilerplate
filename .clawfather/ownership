# Who owns which path — the contract between the boilerplate and a derived
# repository. `tools/upstream` reads the `upstream:` lines (git pathspecs).
#
# upstream:  the boilerplate's. A derived repository takes changes here with
#            `tools/upstream apply` and sends generic fixes back with
#            `tools/upstream backport`. Editing one locally is allowed — it
#            is a visible divergence that `tools/upstream status` reports.
# instance:      the derived repository's. The boilerplate ships a starting point
#            and never changes it for you after the copy.

upstream: bin/
upstream: core/
upstream: hosting/
upstream: tools/
upstream: tests/
upstream: docs/
upstream: .clawfather/ownership
upstream: LICENSE
upstream: .gitignore        # instances add ignores in instance/.gitignore
upstream: .dockerignore
upstream: instance/claw.env.example
upstream: instance/configure.d/README.md
upstream: instance/workspaces/README.md

instance: instance/                 # claw.env, compose.yml, image/, configure.d/, workspaces/
instance: .github/workflows/    # copied from hosting/<profile>/workflows/, then yours
instance: .clawfather/upstream.env
instance: .clawfather/private-terms
instance: README.md
instance: AGENTS.md
