# This deployment. Copy to instance/claw.env and commit it — it holds no secrets.
# Secrets go to .secrets/claw.env (ignored) or the profile's vault.
#
# Instance-owned: the boilerplate never changes instance/claw.env, only this example.

# Which hosting profile: local | azure | hetzner-cloudflare
CLAW_PROFILE=local

# Lowercase slug. Names the compose project, containers, network, image and
# the host data root (/srv/<instance> on hosted profiles).
CLAW_INSTANCE=teamclaw

# Public hostname (hosted profiles). Empty for local.
CLAW_HOSTNAME=

# Host-loopback operations port.
CLAW_PORT=18789

CLAW_TZ=UTC

# People. JSON arrays of e-mail addresses.
#   CLAW_ACCESS_EMAILS  who may sign in (front door allowlist)
#   CLAW_ADMIN_EMAILS   who additionally gets operator.admin
CLAW_ACCESS_EMAILS='[]'
CLAW_ADMIN_EMAILS='[]'

# Upstream OpenClaw image the core image builds on. Pin it; bump by PR.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.6-browser

# Registry for hosted profiles (image name without tag), e.g.
#   ghcr.io/<owner>/<repo>-openclaw    or   <registry>.azurecr.io/claw-openclaw
# CLAW_IMAGE_NAME=

# ── Profile: azure ──────────────────────────────────────────────────────────
# CLAW_ACME_EMAIL=ops@example.com          Let's Encrypt contact
# CLAW_OAUTH_PROVIDER=google               any oauth2-proxy provider
# CLAW_ACCESS_DOMAINS=example.com          sign-in by domain (empty: allowlist only)
# CLAW_AZURE_CLIENT_ID / CLAW_RUNTIME_KEYVAULT are written by the deploy
# workflow from the Bicep outputs. Secrets (OAUTH2_PROXY_*) come from Key Vault.
# See hosting/azure/README.md.

# ── Profile: hetzner-cloudflare ─────────────────────────────────────────────
# Instance, hostname and people above also drive the Access policy.
# Other OpenTofu inputs: instance/infra/terraform.tfvars, instance/infra/backend.hcl.
# CLOUDFLARE_TUNNEL_TOKEN is a secret, delivered by the deploy workflow.
# See hosting/hetzner-cloudflare/README.md.
