# Profile: azure — one Azure VM running Docker Compose. Upstream-owned.
#
# Caddy terminates TLS and asks oauth2-proxy whether the browser has a
# session; only then does it forward to the gateway with the signed-in
# identity in a header. The gateway trusts exactly Caddy's pinned address.
# Data root: /srv/<instance>, the VM's locked data disk.
CLAW_AUTH_MODE=trusted-proxy

# Caddy's fixed address on the claw network (core/compose.yml subnet, lower
# half — never handed out dynamically). hosting/azure/compose.yml pins Caddy
# to this value and oauth2-proxy trusts it too, so it is the single source.
CLAW_TRUSTED_PROXY=172.30.0.10
CLAW_IDENTITY_HEADER=x-auth-request-email
CLAW_REQUIRED_HEADER=x-auth-request-user

# oauth2-proxy decides who may sign in: it can express both "anyone at this
# domain" (CLAW_ACCESS_DOMAINS) and an e-mail allowlist (CLAW_ACCESS_EMAILS).
# The gateway repeating only the allowlist would lock out domain members.
CLAW_GATEWAY_ALLOWLIST=no

# Directories under the data root that the front door mounts; `bin/claw init`
# creates them. A site that needs more should append, not replace:
#   CLAW_EXTRA_DATA_DIRS="$CLAW_EXTRA_DATA_DIRS bundle"     (in site/claw.env)
CLAW_EXTRA_DATA_DIRS="caddy/data caddy/config oauth2-proxy"
