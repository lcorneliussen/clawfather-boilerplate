# Profile: hetzner-cloudflare — one Hetzner Cloud host running the compose
# stack, reachable only through a Cloudflare Tunnel behind Cloudflare Access.
# Upstream-owned; an instance overrides any of these in instance/claw.env.
#
# The data root defaults to /srv/$CLAW_INSTANCE (bin/claw), which Ansible
# mounts from the persistent Hetzner volume.

CLAW_AUTH_MODE=trusted-proxy

# cloudflared's pinned address on the claw network (compose.yml). The gateway
# trusts identity headers from this address and from nothing else.
CLAW_TRUSTED_PROXY=172.30.0.10

# Cloudflare Access sets both on every request it lets through. The JWT header
# is required so a request that bypassed Access can never pass as anonymous.
CLAW_IDENTITY_HEADER=cf-access-authenticated-user-email
CLAW_REQUIRED_HEADER=cf-access-jwt-assertion

# Access already enforces the e-mail allowlist; the gateway repeats it as a
# second fence (same CLAW_ACCESS_EMAILS, so the two cannot drift).
CLAW_GATEWAY_ALLOWLIST=yes
