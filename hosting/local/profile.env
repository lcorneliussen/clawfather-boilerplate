# Profile: local — Docker Compose on a workstation. Upstream-owned.
# The gateway listens on host loopback only and authenticates with a shared
# bearer token that `bin/claw init` generates into .secrets/claw.env.
CLAW_AUTH_MODE=token
# Repository-relative, ignored by git. Hosted profiles use /srv/<instance>.
CLAW_DATA=.data
# Rebuild on every deploy: a workstation is where Dockerfile and OpenClaw
# bumps get tried, and the layer cache keeps an unchanged build fast.
CLAW_BUILD=yes
